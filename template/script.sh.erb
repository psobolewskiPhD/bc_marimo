#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

# Set working directory to marimo_notebooks directory
MARIMO_NB_DIR="${HOME}/marimo_notebooks"
mkdir -p "${MARIMO_NB_DIR}"

<%- unless context.modules.blank? -%>
# Purge the module environment to avoid conflicts
module purge

# Load the require modules
module load <%= context.modules %>

# List loaded modules
module list
<%- end -%>

# Benchmark info
echo "TIMING - Starting marimo at: $(date)"

# Launch marimo
#
# Each job gets a private /tmp, so the uv cache, the downloaded Python
# interpreters and the per-notebook sandbox venvs (created there by marimo via
# mkdtemp) all live under /tmp and are discarded with the job.

apptainer exec \
    --env UV_CACHE_DIR=/tmp/uv \
    --env UV_PYTHON_INSTALL_DIR=/tmp/uv/python \
    --env UV_LINK_MODE=hardlink \
    "${CONTAINER}" \
    uv tool run marimo edit "${MARIMO_NB_DIR}" \
    --sandbox \
    --headless \
    --host 0.0.0.0 \
    --port "${PORT}" \
    --token --token-password-file "${PASSWORD_FILE}"